{
  "name": "@midscene/web",
  "description": "Playwright integration for AI-powered browser automation. See https://midscenejs.com/ for details.",
  "keywords": ["AI UI automation", "AI testing", "Browser use", "Playwright"],
  "version": "1.13.3",
  "repository": "https://github.com/web-infra-dev/midscene",
  "homepage": "https://midscenejs.com/",
  "main": "./dist/lib/index.js",
  "types": "./dist/types/index.d.ts",
  "module": "./dist/es/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/lib/index.js",
      "import": "./dist/es/index.mjs"
    },
    "./playwright": {
      "types": "./dist/types/playwright/index.d.ts",
      "require": "./dist/lib/playwright/index.js",
      "import": "./dist/es/playwright/index.mjs"
    },
    "./playwright/agent": {
      "types": "./dist/types/playwright/agent.d.ts",
      "require": "./dist/lib/playwright/agent.js",
      "import": "./dist/es/playwright/agent.mjs"
    },
    "./static": {
      "types": "./dist/types/static/index.d.ts",
      "require": "./dist/lib/static/index.js",
      "import": "./dist/es/static/index.mjs"
    },
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "require": "./dist/lib/utils.js",
      "import": "./dist/es/utils.mjs"
    }
  },
  "scripts": {
    "dev": "npm run build:watch",
    "build": "rslib build",
    "build:watch": "rslib build --watch --no-clean",
    "test": "rstest",
    "test:u": "rstest -u"
  },
  "files": ["dist", "README.md"],
  "dependencies": {
    "@midscene/core": "workspace:*",
    "@midscene/shared": "workspace:*",
    "semver": "7.5.2",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rslib/core": "^0.18.3",
    "@rstest/core": "0.12.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^18.0.0",
    "@types/semver": "7.7.0",
    "js-yaml": "4.1.0",
    "playwright": "1.63.0",
    "puppeteer": "24.6.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.45.0",
    "playwright": "^1.45.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT"
}
